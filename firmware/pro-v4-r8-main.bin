 e.innerHTML='';var b=document.createElement('button');b.textContent='â–¶ Play '+n;b.style.cssText='font:bold 18px sans-serif;padding:8px 14px;cursor:pointer';
 b.onclick=function(){window.open(u,'_blank');e.style.display='none';};var x=document.createElement('button');x.textContent='âœ•';x.style.cssText='font:16px sans-serif;padding:6px 10px;cursor:pointer';x.onclick=function(){e.style.display='none';};
 e.appendChild(b);e.appendChild(x);e.style.display='flex';}
var wxAt=0;
