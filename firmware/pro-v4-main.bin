 var ev=[];for(var k=0;k<nt&&p<d.length;k++){var id=String.fromCharCode(d[p],d[p+1],d[p+2],d[p+3]);p+=4;var len=u32(),end=p+len,tick=0,rs=0;if(id!='MTrk'){p=end;continue;}
